# Copy to .env and load it into your shell before starting the app.
# No real secrets belong in this example file.

# Leave blank for local development to use the private instance/.secret_key file.
# Set a long, random value for a deployment.
AD_SECRET_KEY=

# A relative SQLite path is stored under Flask's instance/ directory.
AD_SQLALCHEMY_DATABASE_URI=sqlite:///authentic_dynamics.db
AD_SQLALCHEMY_TRACK_MODIFICATIONS=false

# Maximum request size in bytes (16 MiB; converter files are limited to 10 MiB).
AD_MAX_CONTENT_LENGTH=16777216

# Set this to true when the site is served over HTTPS, including the admin login.
# Admin accounts are created with `flask --app wsgi admin create`; no password belongs here.
AD_SESSION_COOKIE_HTTPONLY=true
AD_SESSION_COOKIE_SECURE=false
AD_SESSION_COOKIE_SAMESITE=Lax
